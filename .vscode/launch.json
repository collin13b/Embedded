{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) 启动调试",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            
            // 👇👇👇 核心修改：添加这个 environment 块 👇👇👇
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": "" 
                }
            ],
            // 👆👆👆 这会让 GDB 找不到下载服务器，彻底死心 👆👆👆

            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "反汇编风格",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
